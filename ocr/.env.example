GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Fallback models (comma-separated) tried in order if primary model experiences 503/high demand/rate limits:
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-2.5-pro,gemini-2.5-flash-lite

# Bounded retries and backoff for transient errors (429, 503, high demand, timeouts)
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY=1.0
MAX_RETRIES=2

BATCH_SIZE=3
PDF_DPI=200
MAX_UPLOAD_BYTES=20971520
USE_MOCK_MODE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── OCR ───────────────────────────────────────────────────────────────────
# ppocr (default) runs PP-OCR first and falls back to Tesseract on any page it
# reads poorly. tesseract uses Tesseract only.
OCR_ENGINE=ppocr
# Set false to skip OCR entirely; the model still receives the page image.
USE_OCR_HINT=true
# Hint budget per page. Was hard-coded to 1500, which truncated 27-33% of the
# text on dense itemised bills.
OCR_MAX_CHARS=6000
# Tesseract only: mean word confidence below which the hint is dropped.
OCR_MIN_CONFIDENCE=35
# PP-OCR only: discard detections recognised below this score.
OCR_REC_MIN_SCORE=0.5
# PP-OCR only: below this many characters the page is retried with Tesseract.
OCR_MIN_CHARS=40
# PP-OCR only: below this many characters Tesseract runs as a second opinion
# and whichever transcription carries more numeric tokens is used. Measured on
# 50 pages of real bills: 9 pages trigger it, 3 change engine.
OCR_THIN_CHARS=800
# Tesseract only: the confidence gate also requires the word count to be below
# this before a hint is discarded. A dense page scoring 33.3 across 955 words
# is noisy, not collapsed.
OCR_MIN_WORDS=40
# Row reconstruction from PP-OCR bounding boxes.
OCR_ROW_Y_TOL=0.6
OCR_ROW_GAP=0.75
# Correct page rotation via Tesseract OSD before OCR and extraction.
OCR_AUTOROTATE=true
# 180-degree flips are off by default: OSD reads 90/270 from text-line geometry
# (reliable) but 0-vs-180 from glyph shape (not). On a real 5-page bill it
# claimed 180 on every page at up to 5.86 confidence and was wrong each time,
# which took Tesseract from 2563 characters to zero. Enable only if your scans
# are reliably fed upside down.
OCR_AUTOROTATE_180=false
# Ignore any OSD call less confident than this.
OCR_OSD_MIN_CONFIDENCE=2.0

# Explicit binary paths (Windows, or non-standard installs)
TESSERACT_CMD=
POPPLER_PATH=
